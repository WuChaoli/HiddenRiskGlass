# Copy this file to .env and fill in machine-local Android tool paths.
JAVA_HOME="/path/to/wsl/jdk"
ANDROID_HOME="/path/to/wsl/android-sdk"
WIN_ANDROID_ADB="/mnt/c/Users/<user>/AppData/Local/Android/Sdk/platform-tools/adb.exe"
WIN_JAVA_HOME="C:/Program Files/Android/Android Studio/jbr"

ANDROID_COMPILE_SDK="34"
ANDROID_NDK_VERSION="29.0.14206865"
ANDROID_CMAKE_VERSION="3.22.1"
ANDROID_BUILD_TOOLS_VERSION="35.0.0"

DEBUG_KEYSTORE_PATH="$HOME/.android/debug.keystore"

# Complete every RELEASE_* value to produce an upgradeable release-signed APK.
RELEASE_KEYSTORE_PATH=""
RELEASE_KEY_ALIAS=""
RELEASE_KEYSTORE_PASSWORD=""
RELEASE_KEY_PASSWORD=""
RELEASE_CERT_SHA256=""
