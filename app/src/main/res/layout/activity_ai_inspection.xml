<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivLoadingSpinner"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_loading" />

        <ImageView
            android:id="@+id/ivLoadingComplete"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLoadingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ai_inspection_loading_title"
            android:textColor="@color/green"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadingSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ai_inspection_loading_subtitle"
            android:textColor="@color/green"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="240dp"
            android:layout_height="10dp"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_fill" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="0%"
            android:textColor="@color/green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutGuideCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/glass_card_outline"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:id="@+id/layoutGuideContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvConfirmPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_inspection_confirm_prompt"
                android:textColor="@color/green"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLoadingHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/green"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutDetection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="操作指引"
                    android:textColor="@color/green"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="310dp"
                android:layout_height="310dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="36dp">

                <View
                    android:layout_width="310dp"
                    android:layout_height="310dp"
                    android:background="@drawable/glass_radar_ring" />

                <View
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center"
                    android:background="@drawable/glass_radar_ring" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:background="@drawable/glass_radar_ring" />

                <ImageView
                    android:id="@+id/ivMayHazardLoading"
                    android:layout_width="310dp"
                    android:layout_height="310dp"
                    android:src="@drawable/glass_radar_sweep"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

                <View
                    android:id="@+id/viewCrosshairHorizontal"
                    android:layout_width="200dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center"
                    android:background="@color/green_normal_40" />

                <View
                    android:id="@+id/viewCrosshairVertical"
                    android:layout_width="2dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:background="@color/green_normal_40" />

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:background="@drawable/glass_radar_core" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvDetectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="@string/ai_detection_offline_running"
                android:textColor="@color/green"
                android:textSize="19sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="说出“分析”\n说出“返回”\n说出“结束”\n单击分析\n双击返回"
                    android:textColor="@color/green"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/glass_status_time_mock"
                        android:textColor="@color/green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="12dp">

                        <View
                            android:layout_width="32dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:background="@drawable/ic_battery_outline" />

                        <TextView
                            android:id="@+id/tvBatteryLevel"
                            android:layout_width="28dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="@string/glass_status_battery_mock"
                            android:textColor="@color/green"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <com.rokid.glass.component.StatusAlertOverlayView
        android:id="@+id/statusAlertOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/layoutStreamResponse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="18dp"
                android:text="操作指引"
                android:textColor="@color/green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/scrollContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="140dp"
                android:layout_marginHorizontal="20dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tvStreamContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card_outline"
                    android:lineSpacingExtra="5dp"
                    android:padding="18dp"
                    android:textColor="@color/green"
                    android:textSize="17sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/tvSyncPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_inspection_sync_prompt"
                    android:textColor="@color/green"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSyncHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ai_detection_result_hint"
                    android:textColor="@color/green"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutSyncSuccess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_check_circle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ai_inspection_synced"
            android:textColor="@color/green"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_inspection_synced_detail"
            android:textColor="@color/green"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvContinuePrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/ai_inspection_continue_prompt"
            android:textColor="@color/green"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSyncSuccessHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="@string/ai_inspection_continue_hint"
        android:textColor="@color/green"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
