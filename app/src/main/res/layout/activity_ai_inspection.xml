<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivLoadingSpinner"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_loading" />

        <ImageView
            android:id="@+id/ivLoadingComplete"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLoadingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ai_inspection_loading_title"
            android:textColor="@color/green"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadingSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ai_inspection_loading_subtitle"
            android:textColor="@color/green"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="240dp"
            android:layout_height="10dp"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_fill" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="0%"
            android:textColor="@color/green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutGuideCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/glass_card_outline"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:id="@+id/layoutGuideContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvConfirmPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_inspection_confirm_prompt"
                android:textColor="@color/green"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLoadingHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/green"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutDetection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <FrameLayout
            android:id="@+id/layoutLivePreviewCard"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/glass_card_outline"
            android:padding="4dp">

            <com.rokid.glass.component.RokidCameraPreviewView
                android:id="@+id/viewLivePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 弹性占位，把底部内容推到底部 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.rokid.glass.component.GlassStatusBar
                android:id="@+id/statusBarDetecting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/inspection_status_bar_padding_horizontal"
                android:paddingBottom="@dimen/inspection_status_bar_padding_bottom" />
        </LinearLayout>

        <!-- 右上角操作指引 -->
        <com.rokid.glass.component.OperationGuideView
            android:id="@+id/operationGuideDetecting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/inspection_operation_guide_margin_top"
            android:layout_marginEnd="@dimen/inspection_operation_guide_margin_end" />
    </FrameLayout>

    <com.rokid.glass.component.StatusAlertOverlayView
        android:id="@+id/statusAlertOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/layoutStreamResponse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/layoutStreamThumbnailCard"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/glass_card_outline"
            android:padding="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivStreamThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 右上角操作指引 -->
        <com.rokid.glass.component.OperationGuideView
            android:id="@+id/operationGuideStream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/inspection_operation_guide_margin_top"
            android:layout_marginEnd="@dimen/inspection_operation_guide_margin_end" />

        <!-- 底部区域：结果卡片 + 底部提示 + 状态栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/scrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/inspection_bottom_card_margin_horizontal"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card_outline"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStreamContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:padding="12dp"
                        android:textColor="@color/green"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>

            <com.rokid.glass.component.BottomPromptView
                android:id="@+id/bottomPromptSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inspection_bottom_prompt_margin_top"
                android:layout_marginBottom="@dimen/inspection_bottom_prompt_status_spacing" />

            <com.rokid.glass.component.GlassStatusBar
                android:id="@+id/statusBarStream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/inspection_status_bar_padding_horizontal"
                android:paddingBottom="@dimen/inspection_status_bar_padding_bottom" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/layoutSyncSuccess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- 中央内容：图标 + 文字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivSyncSuccessIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_check_circle" />

            <ImageView
                android:id="@+id/ivSyncLoading"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@mipmap/ic_loading"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSyncStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ai_inspection_synced"
                android:textColor="@color/green"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSyncStatusDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_inspection_synced_detail"
                android:textColor="@color/green"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 右上角操作指引 -->
        <com.rokid.glass.component.OperationGuideView
            android:id="@+id/operationGuideSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/inspection_operation_guide_margin_top"
            android:layout_marginEnd="@dimen/inspection_operation_guide_margin_end" />

        <!-- 底部区域：底部提示 + 状态栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <com.rokid.glass.component.BottomPromptView
                android:id="@+id/bottomPromptSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/inspection_bottom_prompt_status_spacing"
                android:visibility="gone" />

            <com.rokid.glass.component.GlassStatusBar
                android:id="@+id/statusBarSyncSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/inspection_status_bar_padding_horizontal"
                android:paddingBottom="@dimen/inspection_status_bar_padding_bottom" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
