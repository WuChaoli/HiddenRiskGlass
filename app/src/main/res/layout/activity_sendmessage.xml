<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/llMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:context="com.rokid.glass.SendMessageActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/wfSendTextBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/round_select_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="P2P发送文本"
                android:textColor="@color/green" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/wfSendFileBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/round_unselect_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="P2P发送文件"
                android:textColor="@color/green_normal_40" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btSendTextBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/round_unselect_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="蓝牙发送文本"
                android:textColor="@color/green_normal_40" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btSendFileBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/round_unselect_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="蓝牙发送文件"
                android:textColor="@color/green_normal_40" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btTts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/round_unselect_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="文本转语音"
                android:textColor="@color/green_normal_40" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btAsr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/round_unselect_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="语音转文本"
                android:textColor="@color/green_normal_40" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btSendAudioStream"
                android:layout_width="88dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/round_unselect_bg"
                android:paddingVertical="4dp"
                android:text="发送音频流"
                android:textColor="@color/green_normal_40" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/round_unselect_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:visibility="invisible"
                android:textColor="@color/green_normal_40" />

        </LinearLayout>


    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/scrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llMain">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ar_glass_green"
                android:textSize="11sp" />

        </LinearLayout>

    </ScrollView>

    <View
        android:id="@+id/keyMark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>