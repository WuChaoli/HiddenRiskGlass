<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="80dp">

        <!-- 横向滑动菜单卡片（RecyclerView + SnapHelper） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMenu"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="24dp"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:overScrollMode="never" />

        <!-- 中间提示 -->
        <TextView
            android:id="@+id/tvBottomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/ai_entry_menu_hint"
            android:textColor="@color/green"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部操作提示 -->
        <LinearLayout
            android:id="@+id/layoutBottomVoiceHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_entry_menu_voice_hint"
                android:textColor="@color/green"
                android:textSize="13sp" />
        </LinearLayout>

        <com.rokid.glass.component.GlassStatusBar
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp" />
    </LinearLayout>
</FrameLayout>
