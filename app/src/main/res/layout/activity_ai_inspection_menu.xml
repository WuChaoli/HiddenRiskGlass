<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="false">

    <TextView
        android:id="@+id/tvInspectionSummary"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/green"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvWifiConnectedToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/inspection_upload_success_toast_margin_bottom"
        android:background="@drawable/glass_card_outline"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/ai_entry_wifi_connected"
        android:textColor="@color/green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingTop="80dp"
        android:overScrollMode="never">

        <!-- 横向滑动菜单卡片（RecyclerView + SnapHelper） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMenu"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="24dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingHorizontal="20dp"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false" />

        <!-- 中间提示 -->
        <TextView
            android:id="@+id/tvBottomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/ai_entry_menu_hint"
            android:textColor="@color/green"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部操作提示 -->
        <LinearLayout
            android:id="@+id/layoutBottomVoiceHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_entry_menu_voice_hint"
                android:textColor="@color/green"
                android:textSize="13sp" />
        </LinearLayout>

        <com.rokid.glass.component.GlassStatusBar
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp" />
    </LinearLayout>

    <!-- WiFi 未连接时的提示覆盖层 -->
    <LinearLayout
        android:id="@+id/layoutWifiRequiredDialog"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_status_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvWifiRequiredMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ai_entry_wifi_required_message"
            android:textColor="@color/green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWifiRetry"
                android:layout_width="86dp"
                android:layout_height="40dp"
                android:background="@drawable/glass_card_outline_selected"
                android:gravity="center"
                android:text="@string/ai_entry_wifi_retry"
                android:textColor="@color/green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWifiExit"
                android:layout_width="86dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/glass_card_outline"
                android:gravity="center"
                android:text="@string/ai_entry_wifi_exit"
                android:textColor="@color/green"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 退出确认覆盖层 -->
    <LinearLayout
        android:id="@+id/layoutExitConfirmDialog"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_status_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvExitConfirmMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ai_entry_exit_confirm_message"
            android:textColor="@color/green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutExitConfirmActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvExitConfirmConfirm"
                android:layout_width="86dp"
                android:layout_height="40dp"
                android:background="@drawable/glass_card_outline_selected"
                android:gravity="center"
                android:text="@string/ai_entry_exit_confirm_confirm"
                android:textColor="@color/green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExitConfirmCancel"
                android:layout_width="86dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/glass_card_outline"
                android:gravity="center"
                android:text="@string/ai_entry_exit_confirm_cancel"
                android:textColor="@color/green"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
