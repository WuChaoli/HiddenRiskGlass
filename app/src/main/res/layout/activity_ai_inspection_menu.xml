<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="80dp"
        android:overScrollMode="never">

        <!-- 横向滑动菜单卡片（RecyclerView + SnapHelper） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMenu"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="24dp"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false" />

        <!-- 中间提示 -->
        <TextView
            android:id="@+id/tvBottomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/ai_entry_menu_hint"
            android:textColor="@color/green"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部操作提示 -->
        <LinearLayout
            android:id="@+id/layoutBottomVoiceHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_entry_menu_voice_hint"
                android:textColor="@color/green"
                android:textSize="13sp" />
        </LinearLayout>

        <com.rokid.glass.component.GlassStatusBar
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp" />
    </LinearLayout>

    <!-- WiFi 未连接时的提示覆盖层 -->
    <LinearLayout
        android:id="@+id/layoutWifiRequiredDialog"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_status_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvWifiRequiredMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ai_entry_wifi_required_message"
            android:textColor="@color/green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWifiRequiredConfirm"
            android:layout_width="120dp"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/inspection_mode_item_bg_selected"
            android:gravity="center"
            android:text="@string/ai_entry_wifi_required_confirm"
            android:textColor="@color/green"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
