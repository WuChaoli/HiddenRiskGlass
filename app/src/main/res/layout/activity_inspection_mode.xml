<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:text="@string/inspection_mode_title"
        android:textColor="@color/green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 模式选项容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp">

        <!-- AI识患 -->
        <FrameLayout
            android:id="@+id/itemAiInspection"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/inspection_mode_item_bg_selected">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAiIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/inspection_mode_ai"
                    android:src="@mipmap/icon_ai_chat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/inspection_mode_ai"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 任务检查 -->
        <FrameLayout
            android:id="@+id/itemTaskInspection"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/inspection_mode_item_bg">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivTaskIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/inspection_mode_task"
                    android:src="@mipmap/icon_face_recog" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/inspection_mode_task"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 闪拍：批量采集模型测试样本图片 -->
        <FrameLayout
            android:id="@+id/itemLightshot"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/inspection_mode_item_bg">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLightshotIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="闪拍"
                    android:src="@mipmap/icon_take_photo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="闪拍"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/itemUnifiedInputDebug"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/inspection_mode_item_bg">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivUnifiedInputDebugIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/inspection_mode_unified_input_debug"
                    android:src="@mipmap/icon_ai_thinking" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/inspection_mode_unified_input_debug"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- 底部提示 -->
    <TextView
        android:id="@+id/tvBottomHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:text="@string/inspection_mode_hint"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

</FrameLayout>
