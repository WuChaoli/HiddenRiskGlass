<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/tvFunctionMenuTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/inspection_function_menu_title"
        android:textColor="@color/green"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="功能菜单" />

    <View
        android:id="@+id/viewFunctionMenuDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/green" />

    <TextView
        android:id="@+id/tvFunctionMenuContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/inspection_function_menu_content"
        android:textColor="@color/green"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="隐患拍照&#10;设备指引&#10;结束任务" />
</merge>
