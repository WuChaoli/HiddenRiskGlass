                <TextView
                    android:id="@+id/bt_close_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/darker_gray"
                    android:padding="10dp"
                    android:text="closeCamera"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="@id/bt_photo_480P"
                    app:layout_constraintTop_toBottomOf="@id/bt_stopRecord" />


                <TextView
                    android:id="@+id/bt_sendVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@android:color/darker_gray"
                    android:padding="10dp"
                    android:text="sendVideo"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/bt_close_camera"
                    app:layout_constraintTop_toTopOf="@id/bt_close_camera" />

                <TextView
                    android:id="@+id/btn_set_zoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/darker_gray"
                    android:padding="10dp"
                    android:text="setZoom"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="@id/bt_photo_480P"
                    app:layout_constraintTop_toBottomOf="@id/bt_close_camera" />

                <TextView
                    android:id="@+id/bt_stopSendVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@android:color/darker_gray"
                    android:padding="10dp"
                    android:text="stopSendVideo"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/btn_set_zoom"
                    app:layout_constraintTop_toTopOf="@id/btn_set_zoom" />


                <TextView
                    android:id="@+id/btn_recordAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/darker_gray"
                    android:padding="10dp"
                    android:text="采集Audio"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_set_zoom" />

                <TextView
                    android:id="@+id/btn_stopRecordAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="5dp"
                    android:background="@android:color/darker_gray"
                    android:padding="10dp"
                    android:text="停止采集Audio"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/btn_recordAudio"
                    app:layout_constraintTop_toBottomOf="@id/btn_set_zoom" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>


    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>