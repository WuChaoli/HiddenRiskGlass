<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/ivPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.38"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glass_bottom_scrim" />

    <!-- 右上角操作指引 -->
    <com.rokid.glass.component.OperationGuideView
        android:id="@+id/operationGuideEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="14dp" />

    <!-- 底部区域：卡片 + 提示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card_outline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- 左侧：3 张缩略图 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivThumb1"
                    android:layout_width="36dp"
                    android:layout_height="27dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/icon_photo" />

                <ImageView
                    android:id="@+id/ivThumb2"
                    android:layout_width="36dp"
                    android:layout_height="27dp"
                    android:layout_marginStart="3dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/icon_photo" />

                <ImageView
                    android:id="@+id/ivThumb3"
                    android:layout_width="36dp"
                    android:layout_height="27dp"
                    android:layout_marginStart="3dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/icon_photo" />
            </LinearLayout>

            <!-- 右侧：隐患数量 -->
            <TextView
                android:id="@+id/tvHazardCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="分析出3条隐患"
                android:textColor="@color/green"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 底部提示 -->
        <com.rokid.glass.component.BottomPromptView
            android:id="@+id/bottomPromptEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 状态栏 -->
        <com.rokid.glass.component.GlassStatusBar
            android:id="@+id/statusBarEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp" />
    </LinearLayout>
</FrameLayout>
